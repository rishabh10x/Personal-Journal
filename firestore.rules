rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All Security Invariant
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Journal Entry Validation Helper (Anti-Update-Gap)
    function isValidJournal(data, userId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('rawContent' in data) || (data.rawContent is string && data.rawContent.size() <= 100000))
        && (!('encryptedData' in data) || (data.encryptedData is string && data.encryptedData.size() <= 100000))
        && (!('iv' in data) || (data.iv is string && data.iv.size() <= 64))
        && (!('salt' in data) || (data.salt is string && data.salt.size() <= 64))
        && (!('isEncrypted' in data) || data.isEncrypted is bool)
        && (!('sentiment' in data) || (data.sentiment is string && data.sentiment.size() <= 64))
        && (!('distressScore' in data) || (data.distressScore is number && data.distressScore >= 0.0 && data.distressScore <= 1.0))
        && (!('crisisDetected' in data) || data.crisisDetected is bool)
        && (!('environmentTag' in data) || (data.environmentTag is string && data.environmentTag.size() <= 64))
        && (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 4000))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20))
        && (!('reflections' in data) || (data.reflections is list && data.reflections.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('id' in data) || (data.id is string && data.id.size() <= 128));
    }

    // Isolated Per-User Journal Document Hierarchy: /users/{userId}/journals/{journalId}
    match /users/{userId}/journals/{journalId} {
      // Document ID poisoning guard
      allow get: if isOwner(userId) && isValidId(journalId);
      
      // Strict List Evaluation: Evaluates resource.data against request.auth.uid to prevent query scraping
      allow list: if isOwner(userId);

      // Create: strict ownership and schema check
      allow create: if isOwner(userId)
                    && isValidId(journalId)
                    && isValidJournal(incoming(), userId);

      // Update: verifies identity immutability and schema conformity
      allow update: if isOwner(userId)
                    && isValidId(journalId)
                    && isValidJournal(incoming(), userId)
                    && incoming().userId == existing().userId;

      // Delete: only owning user
      allow delete: if isOwner(userId) && isValidId(journalId);
    }
  }
}
